<Window x:Class="TheIsleOverlay.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle Live Map" Width="520" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="Segoe UI" FontSize="12" TextOptions.TextFormattingMode="Display" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <SolidColorBrush x:Key="HomeBone" Color="#E9F4EE" />
        <SolidColorBrush x:Key="HomeMuted" Color="#9EB3AD" />
        <SolidColorBrush x:Key="HomeLine" Color="#35554F" />

        <Style x:Key="HomeChromeButton" TargetType="Button">
            <Setter Property="Foreground" Value="#AFC3BC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#35554F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#183631" />
                                <Setter Property="Foreground" Value="#F3FFF9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#265048" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SourceButton" TargetType="Button" BasedOn="{StaticResource HomeChromeButton}">
            <Setter Property="Height" Value="52" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#C50B2421" />
            <Setter Property="BorderBrush" Value="#486C64" />
        </Style>

        <Style x:Key="SteamAccountCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E9F4EE" />
            <Setter Property="Background" Value="#D00A201D" />
            <Setter Property="BorderBrush" Value="#486C64" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#E9F4EE" />
                        <Setter Property="Background" Value="#0A201D" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                            BorderBrush="#254740" BorderThickness="0,0,0,1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#173D37" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#205047" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="ComboChrome" Background="#D00A201D"
                                        BorderBrush="#486C64" BorderThickness="1" CornerRadius="3">
                                    <Grid Margin="10,5,9,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="M 2 5 L 7 10 L 12 5" Stroke="#72D8C8"
                                              StrokeThickness="1.5" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,3,0,0" Background="#071716" BorderBrush="#4F8177"
                                        BorderThickness="1" CornerRadius="3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#68A99D" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="#37D4C6" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="12" Background="#F2071716" BorderBrush="#6A58736C" BorderThickness="1" CornerRadius="7">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.72" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#2F514B" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="14,0,9,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="#163C38" Stroke="#37D4C6" StrokeThickness="1.5" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="FIELD // LINK" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="11" />
                        <TextBlock Text="  OPEN TELEMETRY CLIENT" Foreground="#86A19A" FontFamily="Bahnschrift" FontSize="10" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource HomeChromeButton}" Content="—" Width="27" Height="23" Padding="0" Click="MinimizeButton_Click" />
                        <Button Style="{StaticResource HomeChromeButton}" Content="×" Width="27" Height="23" Padding="0" Margin="5,0,0,0" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,22,22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ISLE" Foreground="#86A29A" FontFamily="Bahnschrift SemiCondensed" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="LIVE MAP" Foreground="{StaticResource HomeBone}" FontFamily="Bahnschrift SemiCondensed" FontSize="42" FontWeight="Bold" Margin="-2,-7,0,0" />
                            <TextBlock Text="Minimap và chỉ số cá nhân cho The Isle Evrima." Foreground="{StaticResource HomeMuted}" FontSize="13" FontWeight="Medium" Margin="0,2,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="68" Height="68" CornerRadius="34" BorderBrush="#3B665E" BorderThickness="1" VerticalAlignment="Top">
                            <Grid>
                                <Ellipse Width="45" Height="45" Stroke="#385F58" StrokeThickness="1" />
                                <Path Data="M34,12 L43,37 L34,31 L25,37 Z" Fill="#E9F4EE" Stroke="#37D4C6" StrokeThickness="1" />
                                <Ellipse Width="5" Height="5" Fill="#E7B74E" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Rectangle Height="1" Fill="#35554F" Margin="0,18,0,16" />

                    <TextBlock Text="ISLEPILOT NETWORK" Foreground="#A8BDB7" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,9" />

                    <StackPanel Loaded="SteamLoginPanel_Loaded">
                        <Button x:Name="SteamLoginButton" Style="{StaticResource SourceButton}"
                                Height="66" Click="SteamLoginButton_Click" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#173D39"
                                        BorderBrush="#5A8D84" BorderThickness="1" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Line X1="7" Y1="15" X2="15" Y2="9" Stroke="#DDF9F1" StrokeThickness="2.3" />
                                        <Ellipse Canvas.Left="2" Canvas.Top="12" Width="8" Height="8"
                                                 Fill="#173D39" Stroke="#DDF9F1" StrokeThickness="2" />
                                        <Ellipse Canvas.Left="13" Canvas.Top="4" Width="8" Height="8"
                                                 Fill="#37D4C6" Stroke="#DDF9F1" StrokeThickness="1.5" />
                                    </Canvas>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="SteamAccountLabel" Text="CHƯA ĐĂNG NHẬP STEAM"
                                               Foreground="{StaticResource HomeBone}"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="15"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="SteamLoginDetailLabel"
                                               Text="Một phiên cho mọi server đã cài IslePilot"
                                               Foreground="#91AAA3" FontSize="10.5" FontWeight="Medium" />
                                </StackPanel>
                                <TextBlock x:Name="SteamLoginActionLabel" Grid.Column="2"
                                           Text="ĐĂNG NHẬP  →" Foreground="#A0D2C8"
                                           FontFamily="Bahnschrift SemiCondensed" FontSize="10.5"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </Button>

                        <Grid x:Name="SteamAccountControls" Visibility="Collapsed" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="SteamAccountSelector" Style="{StaticResource SteamAccountCombo}"
                                      SelectionChanged="SteamAccountSelector_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontFamily="Bahnschrift SemiCondensed"
                                                       FontWeight="SemiBold" FontSize="12.5" Foreground="#E9F4EE" />
                                            <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="#8FA8A1" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button x:Name="AddSteamAccountButton" Grid.Column="1"
                                    Style="{StaticResource HomeChromeButton}" Content="＋ THÊM TÀI KHOẢN"
                                    Padding="11,6" Margin="8,0,0,0"
                                    Click="AddSteamAccountButton_Click" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Chỉ đọc tọa độ, hướng quay và status dino. Tự nhận server."
                                       Foreground="#78938C" FontSize="10.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button x:Name="LogoutSteamButton" Grid.Column="1"
                                    Style="{StaticResource HomeChromeButton}" Content="XÓA TÀI KHOẢN"
                                    Padding="10,5" Margin="10,0,0,0" Visibility="Collapsed"
                                    Click="LogoutSteamButton_Click" />
                        </Grid>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#2F514B" Margin="0,17,0,14" />

                    <Grid Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SERVER DÙNG WEBSITE RIÊNG" Foreground="#A8BDB7"
                                   FontSize="11.5" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="2 NGUỒN RIÊNG" Foreground="#6F8C84"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="EraSourceButton" Style="{StaticResource SourceButton}" Tag="era"
                                Height="64" Margin="0" Padding="12,0"
                                AutomationProperties.Name="Kết nối trực tiếp EraGaming"
                                Click="SourceButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="#173D39"
                                        BorderBrush="#37D4C6" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="E" Foreground="#65F1DF" FontFamily="Bahnschrift SemiCondensed"
                                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
                                    <TextBlock Text="ERAGAMING" Foreground="{StaticResource HomeBone}"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="eragamingvn.net" Foreground="#93AAA4"
                                               FontSize="10.5" FontWeight="Medium" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" Foreground="#37D4C6"
                                           FontSize="18" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button x:Name="PandoraSourceButton" Grid.Column="2"
                                Style="{StaticResource SourceButton}" Tag="pandora"
                                Height="64" Margin="0" Padding="12,0"
                                AutomationProperties.Name="Kết nối trực tiếp PANDORA"
                                Click="SourceButton_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="6" Background="#352F19"
                                        BorderBrush="#E7B74E" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="P" Foreground="#FFE18B" FontFamily="Bahnschrift SemiCondensed"
                                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,5,0" VerticalAlignment="Center">
                                    <TextBlock Text="PANDORA" Foreground="{StaticResource HomeBone}"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="14"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="islapandora.eu" Foreground="#C5B77A"
                                               FontSize="10.5" FontWeight="Medium" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="→" Foreground="#E7B74E"
                                           FontSize="18" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                    <TextBlock Text="Hai server này dùng phiên đăng nhập riêng trên live map của họ."
                               Foreground="#78938C" FontSize="10.5" TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <TextBlock x:Name="SourceStatusLabel"
                               Text="Chọn IslePilot hoặc kết nối trực tiếp đúng server bạn đang chơi."
                               Foreground="#9CB2AC" FontSize="11.5" FontWeight="Medium"
                               TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#2F514B" BorderThickness="0,1,0,0">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="#37D4C6" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionStatusLabel" Grid.Column="1" Text="ISLE LIVE MAP · ĐANG KIỂM TRA UPDATE" Foreground="#87A39B" FontFamily="Bahnschrift SemiCondensed" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0" />
                    <Button x:Name="ApplyUpdateButton" Grid.Column="2" Style="{StaticResource HomeChromeButton}"
                            Content="UPDATE" Padding="9,4" Margin="8,4,0,4"
                            Foreground="#7DE4D2" BorderBrush="#39756B" Visibility="Collapsed"
                            Click="ApplyUpdateButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
