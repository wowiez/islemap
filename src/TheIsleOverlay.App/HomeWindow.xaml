<Window x:Class="TheIsleOverlay.App.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle of Wie" Width="520" Height="790"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        FontFamily="{StaticResource WieFont}" FontSize="13" Foreground="{StaticResource WieText}"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style x:Key="HomeChromeButton" TargetType="Button" BasedOn="{StaticResource WieButton}" />

        <Style x:Key="SourceButton" TargetType="Button" BasedOn="{StaticResource WieButton}">
            <Setter Property="Height" Value="64" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="Monogram" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MonogramLetter" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WieCream}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="TileDetail" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WieMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,0" />
        </Style>

        <Style x:Key="SteamAccountCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource WieText}" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource WieText}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemChrome" Background="{TemplateBinding Background}"
                                            CornerRadius="9" Margin="4,2" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="{StaticResource WieHover}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemChrome" Property="Background" Value="#22392B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" Cursor="Hand"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Background="Transparent" BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Border x:Name="ComboChrome" Background="{StaticResource WieRaised}"
                                        BorderBrush="{StaticResource WieLineStrong}" BorderThickness="1" CornerRadius="12">
                                    <Grid Margin="12,5,10,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="18" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="M 2 5 L 7 10 L 12 5" Stroke="{StaticResource WieGold}"
                                              StrokeThickness="1.6" StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Width="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0" Background="{StaticResource WieCard}" BorderBrush="{StaticResource WieLineStrong}"
                                        BorderThickness="1" CornerRadius="12" Padding="0,3">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource WieScrollBar}" />
                                        </ScrollViewer.Resources>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboChrome" Property="Background" Value="{StaticResource WieHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboChrome" Property="BorderBrush" Value="{StaticResource WieGold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" Background="{StaticResource WieInk}" BorderBrush="{StaticResource WieLine}" BorderThickness="1" CornerRadius="20">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.7" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="20" Height="20" Source="pack://application:,,,/Assets/IsleOfWieIcon.png"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" FontSize="12.5">
                        <Run Text="Isle of Wie" Foreground="{StaticResource WieCream}" FontWeight="SemiBold" />
                        <Run Text="  live map" Foreground="{StaticResource WieFaint}" />
                    </TextBlock>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource WieGhostButton}" Width="30" Height="28" Click="MinimizeButton_Click"
                                AutomationProperties.Name="Thu nhỏ">
                            <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconMinus}" Width="14" Height="14" />
                        </Button>
                        <Button Style="{StaticResource WieGhostButton}" Width="30" Height="28" Margin="4,0,0,0"
                                Click="CloseButton_Click" AutomationProperties.Name="Đóng">
                            <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconClose}" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource WieScrollBar}" />
                </ScrollViewer.Resources>
                <StackPanel Margin="22,6,22,18">
                    <Grid Margin="0,0,0,22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontSize="40" FontWeight="Bold" Margin="-2,0,0,0">
                                <Run Text="ISLE OF " Foreground="{StaticResource WieCream}" /><Run Text="WIE" Foreground="{StaticResource WieGold}" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="1,0,0,0">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource WieLive}" VerticalAlignment="Center" />
                                <TextBlock Text="L I V E   M A P" Foreground="{StaticResource WieGold}" FontSize="12.5" FontWeight="SemiBold"
                                           Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="Live map" />
                            </StackPanel>
                            <TextBlock Text="Minimap và chỉ số cá nhân cho The Isle Evrima." Foreground="{StaticResource WieMuted}"
                                       FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Image Grid.Column="1" Width="104" Height="104" Margin="12,0,0,0"
                               Source="pack://application:,,,/Assets/IsleOfWie.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center" AutomationProperties.Name="Isle of Wie Live Map" />
                    </Grid>

                    <HeaderedContentControl Style="{StaticResource WieLegendCard}" Header="IslePilot network">
                        <StackPanel Loaded="SteamLoginPanel_Loaded">
                            <Button x:Name="SteamLoginButton" Style="{StaticResource SourceButton}"
                                    Height="66" Click="SteamLoginButton_Click" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="19" Background="#16281E"
                                            BorderBrush="#2B503B" BorderThickness="1" VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconLink}"
                                                        Foreground="{StaticResource WieSea}" Width="18" Height="18" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SteamAccountLabel" Text="CHƯA ĐĂNG NHẬP STEAM"
                                                   Style="{StaticResource TileTitle}" FontSize="13" />
                                        <TextBlock x:Name="SteamLoginDetailLabel"
                                                   Text="Một phiên cho mọi server đã cài IslePilot"
                                                   Style="{StaticResource TileDetail}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource WieCream}" CornerRadius="10" Padding="9,5"
                                            VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SteamLoginActionLabel" Text="ĐĂNG NHẬP" Foreground="#14211A"
                                                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                            <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconArrowRight}"
                                                            Foreground="#14211A" Width="12" Height="12" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Button>

                            <Grid x:Name="SteamAccountControls" Visibility="Collapsed" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SteamAccountSelector" Style="{StaticResource SteamAccountCombo}"
                                          SelectionChanged="SteamAccountSelector_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource WieCream}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource WieMuted}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button x:Name="AddSteamAccountButton" Grid.Column="1"
                                        Style="{StaticResource HomeChromeButton}" Margin="8,0,0,0"
                                        AutomationProperties.Name="Thêm tài khoản"
                                        Click="AddSteamAccountButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconPlus}" Width="13" Height="13" Margin="0,0,6,0" />
                                        <TextBlock Text="THÊM TÀI KHOẢN" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RemoveWebsiteSessionButton" Grid.Column="2"
                                        Style="{StaticResource HomeChromeButton}" Content="XÓA PHIÊN"
                                        Margin="8,0,0,0" Visibility="Collapsed"
                                        Click="RemoveWebsiteSessionButton_Click" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Chỉ đọc tọa độ, hướng quay và status dino. Tự nhận server."
                                           Foreground="{StaticResource WieFaint}" FontSize="11.5" TextWrapping="Wrap"
                                           VerticalAlignment="Center" />
                                <Button x:Name="LogoutSteamButton" Grid.Column="1"
                                        Style="{StaticResource HomeChromeButton}" Content="XÓA TÀI KHOẢN"
                                        FontSize="11" Padding="10,5" Margin="10,0,0,0" Visibility="Collapsed"
                                        Click="LogoutSteamButton_Click" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <HeaderedContentControl Style="{StaticResource WieLegendCard}">
                        <HeaderedContentControl.Header>
                            <TextBlock>
                                <Run Text="Server dùng website riêng" />
                                <Run x:Name="OwnSourceCountLabel" Text="" Foreground="{StaticResource WieFaint}" FontWeight="Medium" />
                            </TextBlock>
                        </HeaderedContentControl.Header>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Button x:Name="EraSourceButton" Style="{StaticResource SourceButton}" Tag="era"
                                        AutomationProperties.Name="Kết nối trực tiếp EraGaming"
                                        Click="SourceButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Monogram}" Background="#0E2A30" BorderBrush="#1B5560">
                                            <TextBlock Text="E" Style="{StaticResource MonogramLetter}" Foreground="{StaticResource WieSea}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="EraGaming" Style="{StaticResource TileTitle}" />
                                            <TextBlock Text="eragamingvn.net" Style="{StaticResource TileDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button x:Name="PandoraSourceButton" Grid.Column="2"
                                        Style="{StaticResource SourceButton}" Tag="pandora"
                                        AutomationProperties.Name="Kết nối trực tiếp PANDORA"
                                        Click="SourceButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Monogram}" Background="#2A2414" BorderBrush="#5C4D2A">
                                            <TextBlock Text="P" Style="{StaticResource MonogramLetter}" Foreground="{StaticResource WieGold}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Pandora" Style="{StaticResource TileTitle}" />
                                            <TextBlock Text="islapandora.eu" Style="{StaticResource TileDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button x:Name="SdvnSourceButton" Grid.Row="2" Style="{StaticResource SourceButton}" Tag="sdvn3"
                                        AutomationProperties.Name="Kết nối trực tiếp SDVN #3"
                                        Click="SourceButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Monogram}" Background="#18291A" BorderBrush="#3D6229">
                                            <TextBlock Text="S" Style="{StaticResource MonogramLetter}" Foreground="{StaticResource WieLand}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SDVN #3 x3 Grow" Style="{StaticResource TileTitle}" />
                                            <TextBlock Text="3.sdvn.org · IslePilot" Style="{StaticResource TileDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button x:Name="SbtcSourceButton" Grid.Row="2" Grid.Column="2" Style="{StaticResource SourceButton}" Tag="sbtc"
                                        AutomationProperties.Name="Kết nối trực tiếp SBTC Island"
                                        Click="SourceButton_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Monogram}" Background="#2B2619" BorderBrush="#6B5E3A">
                                            <TextBlock Text="S" Style="{StaticResource MonogramLetter}" Foreground="{StaticResource WieSand}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="SBTC Island" Style="{StaticResource TileTitle}" />
                                            <TextBlock Text="sbtcislandd.com" Style="{StaticResource TileDetail}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <TextBlock Text="Các server này dùng phiên đăng nhập riêng trên live map của họ."
                                       Foreground="{StaticResource WieFaint}" FontSize="11.5" TextWrapping="Wrap"
                                       Margin="2,12,0,0" />
                        </StackPanel>
                    </HeaderedContentControl>

                    <Button x:Name="GuestModeButton" Style="{StaticResource HomeChromeButton}"
                            Height="44" HorizontalContentAlignment="Center"
                            AutomationProperties.Name="Mở overlay ở chế độ khách, chỉ xem bản đồ"
                            Click="GuestModeButton_Click">
                        <TextBlock>
                            <InlineUIContainer BaselineAlignment="Center"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconEye}"
                                Foreground="{StaticResource WieGold}" Width="16" Height="16" Margin="0,0,8,0" /></InlineUIContainer><Run Text="Chế độ khách" FontWeight="SemiBold" Foreground="{StaticResource WieCream}" />
                            <Run Text="  ·  chỉ xem bản đồ + chỉ số từ game" Foreground="{StaticResource WieMuted}" FontWeight="Normal" />
                        </TextBlock>
                    </Button>

                    <TextBlock x:Name="SourceStatusLabel"
                               Text="Chọn IslePilot hoặc kết nối trực tiếp đúng server bạn đang chơi."
                               Foreground="{StaticResource WieMuted}" FontSize="12"
                               TextWrapping="Wrap" Margin="2,14,0,0" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource WieLine}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource WieLive}" VerticalAlignment="Center" />
                    <TextBlock x:Name="VersionStatusLabel" Grid.Column="1" Text="ISLE OF WIE · ĐANG KIỂM TRA UPDATE"
                               Foreground="{StaticResource WieMuted}" FontSize="11" FontWeight="Medium"
                               VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                    <Button x:Name="ApplyUpdateButton" Grid.Column="2" Style="{StaticResource WiePrimaryButton}"
                            Content="UPDATE" FontSize="11" Padding="12,4" Margin="8,6,0,6" Visibility="Collapsed"
                            Click="ApplyUpdateButton_Click" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
