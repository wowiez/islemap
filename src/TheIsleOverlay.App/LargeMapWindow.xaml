<Window x:Class="TheIsleOverlay.App.LargeMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Isle of Wie" Width="900" Height="900"
        WindowStartupLocation="Manual"
        WindowStyle="None" ResizeMode="NoResize" Background="#080E0B"
        Topmost="True" ShowInTaskbar="False" KeyDown="Window_KeyDown"
        Loaded="Window_Loaded" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <Style x:Key="MapFilterToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#98A18E" />
            <Setter Property="Background" Value="#B30B1510" />
            <Setter Property="BorderBrush" Value="#2E4637" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource WieFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#ECDFB3" />
                    <Setter Property="Background" Value="#B30B1510" />
                    <Setter Property="BorderBrush" Value="#C9A95A" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#C9A95A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Border x:Name="MapBorder" Background="#080E0B" BorderThickness="0"
            CornerRadius="16" Padding="0" ClipToBounds="True">
        <Grid x:Name="MapShell" Background="#080E0B" ClipToBounds="True"
              RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="OpenScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.RenderTransform>

            <Grid x:Name="MapViewport" Background="#080E0B" ClipToBounds="True"
                  MouseWheel="MapViewport_MouseWheel">
            <Viewbox x:Name="MapViewbox" Stretch="Uniform" HorizontalAlignment="Center"
                     VerticalAlignment="Center" SnapsToDevicePixels="True"
                     RenderTransformOrigin="0.5,0.5">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScaleTransform" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="ZoomPanTransform" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
                <Canvas x:Name="LargeMapCanvas" Width="1112" Height="1116"
                        Background="#122219" Cursor="Cross"
                        MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"
                        MouseLeftButtonUp="MapCanvas_MouseLeftButtonUp"
                        MouseMove="MapCanvas_MouseMove"
                        MouseRightButtonDown="MapCanvas_MouseRightButtonDown">
                    <Image x:Name="LargeMapImage" Width="1112" Height="1116"
                           Panel.ZIndex="0" Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image x:Name="LargeDrinkingWaterImage" Width="1112" Height="1116"
                           Panel.ZIndex="0" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False"
                           RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False">
                        <Image.Effect><BlurEffect Radius="0.45" RenderingBias="Quality" /></Image.Effect>
                    </Image>
                    <Canvas x:Name="LargeZoneLayer" Width="1112" Height="1116"
                            Panel.ZIndex="1" IsHitTestVisible="False" />
                    <Canvas x:Name="LargeMapPoiLayer" Width="1112" Height="1116"
                            Panel.ZIndex="1" IsHitTestVisible="False" />
                    <Canvas x:Name="LargeWildlifeLayer" Width="1112" Height="1116"
                            Panel.ZIndex="2" />
                    <Canvas x:Name="LargePathTrailLayer" Width="1112" Height="1116"
                            Panel.ZIndex="2" IsHitTestVisible="False" />
                    <Canvas x:Name="LargePlayerLayer" Width="1112" Height="1116"
                            Panel.ZIndex="3" IsHitTestVisible="False" />
                    <Canvas x:Name="LargeRouteLayer" Width="1112" Height="1116"
                            Panel.ZIndex="4" IsHitTestVisible="False" />
                    <Canvas x:Name="LargeMarkerLayer" Width="1112" Height="1116"
                            Panel.ZIndex="5" IsHitTestVisible="False" />
                </Canvas>
            </Viewbox>
            </Grid>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="MapZonesFilterButton" Content="VÙNG" IsChecked="True"
                                  Style="{StaticResource MapFilterToggleStyle}" Margin="0,0,5,0"
                                  Click="MapLayerFilterButton_Click" ToolTip="Hiện vùng tím/vàng và khu trú ẩn" />
                    <ToggleButton x:Name="MapWildlifeFilterButton" Content="AI" IsChecked="True"
                                  Style="{StaticResource MapFilterToggleStyle}"
                                  Click="MapLayerFilterButton_Click" ToolTip="Hiện động vật AI đang sống" />
                </StackPanel>
            </Border>
            <Button x:Name="QuickClearTrailButton" Content="XÓA ĐƯỜNG ĐI · Ctrl+R"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                    Style="{StaticResource WieButton}" Background="#E518271E"
                    Click="QuickClearTrailButton_Click" ToolTip="Xóa đường đi đã ghi trên các bản đồ" />
        </Grid>
    </Border>
</Window>
