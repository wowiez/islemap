<Window x:Class="TheIsleOverlay.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Đăng nhập nguồn telemetry" Width="1060" Height="760" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#0A140E" Foreground="#F9F4E4"
        FontFamily="Segoe UI Variable Text" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="62" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border BorderBrush="#355543" BorderThickness="0,0,0,1" Background="#0F1C15">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SourceTitleLabel" Text="KẾT NỐI NGUỒN" FontFamily="{StaticResource WieFont}" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock x:Name="HostLabel" Foreground="#7E8A71" FontFamily="{StaticResource WieFont}" FontSize="9" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="PHIÊN RIÊNG CỦA ISLE OF WIE" Foreground="#C9A95A" FontFamily="{StaticResource WieFont}" FontSize="9" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CookieScopeLabel" Foreground="#667D70" FontSize="9" Margin="0,2,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="12" BorderBrush="#355543" BorderThickness="1" Background="#0D1711">
            <Grid>
                <wv2:WebView2 x:Name="LoginBrowser" />
                <Border x:Name="BrowserLoadingPanel" Background="#F20A140E">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="24" Height="24" Stroke="#C9A95A" StrokeThickness="2" />
                        <TextBlock Text="ĐANG MỞ TRANG ĐĂNG NHẬP…" Foreground="#9AA48F" FontFamily="{StaticResource WieFont}" FontSize="10" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#355543" BorderThickness="0,1,0,0" Background="#0F1C15">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="LoginStatusLabel" Text="Nếu chưa đăng nhập, hoàn tất trên website rồi bấm KIỂM TRA PHIÊN." Foreground="#869279" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="KIỂM TRA PHIÊN" Padding="14,7" Margin="10,0,0,0" Click="CheckSessionButton_Click"
                        Background="#1E3829" Foreground="#F9F4E4" BorderBrush="#4F8165" FontFamily="{StaticResource WieFont}" Cursor="Hand" />
                <Button Grid.Column="2" Content="ĐÓNG" Padding="14,7" Margin="8,0,0,0" Click="CloseButton_Click"
                        Background="Transparent" Foreground="#B2B9AA" BorderBrush="#486555" FontFamily="{StaticResource WieFont}" Cursor="Hand" />
            </Grid>
        </Border>
    </Grid>
</Window>
