<Window x:Class="TheIsleOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Isle Live Map" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text" TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closed="Window_Closed" DpiChanged="Window_DpiChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="HudPatternBrush" Color="#A8080D0C" />
    </Window.Resources>
    <Grid x:Name="OverlayScaleRoot" Width="318" UseLayoutRounding="True" SnapsToDevicePixels="True"
          RenderOptions.BitmapScalingMode="HighQuality">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="MapPanel" Grid.Row="0" Height="304" Background="Transparent" ClipToBounds="False">
            <Grid>
                <Ellipse x:Name="CircularMapOuterFrame" Width="292" Height="292" Fill="Transparent" StrokeThickness="0" />
                <Ellipse x:Name="CircularMapInnerFrame" Width="286" Height="286" StrokeThickness="0" />
                <Border x:Name="SquareMapFrame" Width="296" Height="296" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" CornerRadius="5" />

                <Canvas x:Name="MapViewport" Width="282" Height="282" Background="#102423"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        SizeChanged="MapViewport_SizeChanged" ClipToBounds="True">
                    <Canvas.Clip>
                        <EllipseGeometry Center="141,141" RadiusX="141" RadiusY="141" />
                    </Canvas.Clip>
                    <Image x:Name="MapImage" Panel.ZIndex="0" Stretch="Fill" Opacity="0.94" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="MapRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="MapImagePanTransform" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Rectangle x:Name="MapShade" Panel.ZIndex="1" Fill="#09000000" IsHitTestVisible="False" />
                    <Image x:Name="DrinkingWaterImage" Panel.ZIndex="1" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False">
                        <Image.Effect><BlurEffect Radius="0.45" RenderingBias="Quality" /></Image.Effect>
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="DrinkingWaterRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="DrinkingWaterPanTransform" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="SbtcZoneLayer" Panel.ZIndex="2" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcZoneRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcZonePanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcZoneDecorationLayer" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcZoneDecorationRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcZoneDecorationPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="RouteLayer" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="RouteRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="RoutePanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcPlayerLayer" Panel.ZIndex="5" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcPlayerRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcPlayerPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Grid x:Name="PlayerMarker" Panel.ZIndex="6" Width="34" Height="34" IsHitTestVisible="False">
                        <Ellipse Width="27" Height="27" Fill="#35FF2E88" />
                        <Ellipse Width="15" Height="15" Fill="#FF2E88" Stroke="#FFFFFF" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF2E88" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Grid x:Name="DirectionNeedle" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="DirectionNeedleRotationTransform" Angle="0" />
                            </Grid.RenderTransform>
                            <Path Data="M 17,0 L 21,9 L 17,7 L 13,9 Z" Fill="#FFFFFF" Stroke="#FF2E88" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Canvas>

                <Path x:Name="MapNorthIndicator" Visibility="Collapsed" Data="M 151,4 L 159,16 L 143,16 Z" Fill="#37D4C6" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Grid x:Name="CompassRing" Width="272" Height="272"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="CompassRingRotationTransform" Angle="0" />
                    </Grid.RenderTransform>
                    <TextBlock x:Name="CompassNorthLabel" Text="B" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="NorthLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassEastLabel" Text="Đ" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="EastLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassSouthLabel" Text="N" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="SouthLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassWestLabel" Text="T" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="WestLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="CoordinateLabel" Visibility="Collapsed" Text="X —  Y —  Z —" />

                <Border x:Name="HeadingReadout" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#A8071110" CornerRadius="8" Padding="8,3">
                    <TextBlock x:Name="HeadingModeLabel" Text="CHƯA RÕ HƯỚNG" Foreground="#EEE9D9" FontFamily="Bahnschrift SemiCondensed" FontSize="10.5" FontWeight="SemiBold" />
                </Border>

                <TextBlock x:Name="MapStateLabel" Text="ĐANG TẢI BẢN ĐỒ" Foreground="#A5BDB5" Background="#C0091718" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Bahnschrift SemiCondensed" FontSize="10" />
            </Grid>
        </Border>

        <Border x:Name="MapActivitySpacer" Grid.Row="1" Height="8" />

        <Border x:Name="ActivityPanel" Grid.Row="2" Width="248" HorizontalAlignment="Center"
                Background="{StaticResource HudPatternBrush}" BorderBrush="#555A604D" BorderThickness="1"
                CornerRadius="4" Padding="8,6,8,6">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="ActivityReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SpeciesLabel" Text="NO ACTIVE DINOSAUR" Foreground="#EEF3E8"
                               FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GROWTH" Foreground="#A9914A" FontFamily="Bahnschrift SemiCondensed"
                                   FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="GrowthLabel" Text="—" Foreground="#E6BD47" FontFamily="Bahnschrift"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Ellipse x:Name="ConnectionDot" Visibility="Collapsed" Width="5" Height="5" />
                    <TextBlock x:Name="ConnectionLabel" Visibility="Collapsed" Text="ĐANG KHỞI TẠO" />
                    <TextBlock x:Name="PlayerNameLabel" Visibility="Collapsed" Text="Awaiting telemetry" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Máu">
                            <Canvas Width="18" Height="18">
                                <Path Fill="#62DD59" Stroke="#C8FFC3" StrokeThickness="0.7"
                                      Data="M9,16 C7.8,14.8 2,11.1 2,6.4 C2,3.6 5.5,2.2 9,5.2 C12.5,2.2 16,3.6 16,6.4 C16,11.1 10.2,14.8 9,16 Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="HealthBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,8,0" Foreground="#55D64E" VerticalAlignment="Center" />
                        <TextBlock x:Name="HealthValue" Grid.Column="2" Text="— / —" Foreground="#E1E9E5" FontFamily="Bahnschrift" FontSize="9.5" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Thể lực">
                            <Canvas Width="18" Height="18">
                                <Path Fill="#EBD35B" Stroke="#FFF3A1" StrokeThickness="0.6"
                                      Data="M10.5,1 L4,10 L8.2,10 L7,17 L14.5,7.2 L10.3,7.2 Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="StaminaBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,8,0" Foreground="#E6D24D" VerticalAlignment="Center" />
                        <TextBlock x:Name="StaminaValue" Grid.Column="2" Text="— / —" Foreground="#DDE6E1" FontFamily="Bahnschrift" FontSize="9.5" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Viewbox x:Name="FoodSteakIcon" Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Thức ăn">
                            <Canvas Width="20" Height="20">
                                <Path Fill="#E49428" Stroke="#FFD18B" StrokeThickness="0.45" StrokeLineJoin="Round"
                                      Data="M4.5,4.4 C6.1,2.9 8.8,3 10.4,4.6 C12,6.2 11.8,8.7 10.2,10.1 C8.7,11.4 6.2,11.2 4.8,9.8 C3.3,8.3 3,5.8 4.5,4.4 Z M9.5,9.2 L13.2,12.9 C13.8,12.5 14.7,12.6 15.2,13.1 C15.8,13.7 15.7,14.6 15.2,15.1 C14.7,15.6 13.9,15.6 13.4,15.2 C12.9,15.7 12,15.7 11.5,15.2 C10.9,14.6 11,13.7 11.5,13.2 L8.8,10.5 Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="HungerBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,8,0" Foreground="#E49428" VerticalAlignment="Center" />
                        <TextBlock x:Name="HungerValue" Grid.Column="2" Text="— / —" Foreground="#DDE6E1" FontFamily="Bahnschrift" FontSize="9.5" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="27" /><ColumnDefinition Width="*" /><ColumnDefinition Width="62" /></Grid.ColumnDefinitions>
                        <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Nước">
                            <Canvas Width="18" Height="18">
                                <Path Fill="#31A9D7" Stroke="#A7E8FF" StrokeThickness="0.7"
                                      Data="M9,1 C7.6,3.7 3,8.5 3,12 A6,6 0 0 0 15,12 C15,8.5 10.4,3.7 9,1 Z" />
                                <Path Data="M6,12.2 C6.4,14 7.6,14.8 9.1,14.9" Stroke="#BCEFFF" StrokeThickness="0.8" StrokeStartLineCap="Round" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="WaterBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,8,0" Foreground="#31A9D7" VerticalAlignment="Center" />
                        <TextBlock x:Name="WaterValue" Grid.Column="2" Text="— / —" Foreground="#DDE6E1" FontFamily="Bahnschrift" FontSize="9.5" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RequestStatusLabel" Text="" Foreground="#A9914A"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="8.5"
                               FontWeight="SemiBold" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                    <TextBlock x:Name="UpdatedLabel" Grid.Column="1" Text="—" Foreground="#788780"
                               FontFamily="Bahnschrift" FontSize="8.5" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PrimeTasksPanel" Grid.Row="3" Width="248" HorizontalAlignment="Center" Visibility="Collapsed"
                Margin="0,8,0,0" Padding="10,8"
                Background="{StaticResource HudPatternBrush}" BorderBrush="#655A604D"
                BorderThickness="1" CornerRadius="4">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="PrimeTasksReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="#E7B74E" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Grid.Column="1" Text="NHIỆM VỤ PRIME" Foreground="#EEF3E8"
                               FontFamily="Bahnschrift SemiCondensed" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="PrimeTasksProgressLabel" Grid.Column="2" Text="0 / 0"
                               Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="10.5" FontWeight="Bold" />
                </Grid>
                <Rectangle Grid.Row="1" Fill="#405D56" Margin="0,7,0,0" />
                <ItemsControl x:Name="PrimeTasksList" Grid.Row="2" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}"
                                           FontFamily="Bahnschrift" FontSize="11" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding TextBrush}"
                                           FontFamily="Bahnschrift SemiCondensed" FontSize="10.5"
                                           TextWrapping="Wrap" LineHeight="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel" Grid.Row="4" Visibility="Collapsed"
                Margin="0,8,0,0" Padding="9,7"
                Background="{StaticResource HudPatternBrush}" BorderBrush="#655A604D" BorderThickness="1"
                CornerRadius="4">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="SettingsReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OVERLAY SETTINGS" Foreground="#EEF3E8" FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="F8 · GUIDE  /  ALT + M · BIG MAP  /  ALT + = / - · ZOOM" Foreground="#98A49D" FontFamily="Bahnschrift" FontSize="8.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="DONE" Padding="10,4" Click="CloseSettingsButton_Click" />
                </Grid>

                <Rectangle Grid.Row="1" Fill="#405D56" Margin="0,7,0,0" />

                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBlock Text="HUD SIZE" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="OverlayScaleSlider" Grid.Column="1" Minimum="65" Maximum="175" Value="100" SmallChange="5" LargeChange="10"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Margin="7,0" VerticalAlignment="Center" ValueChanged="OverlayScaleSlider_ValueChanged" />
                    <TextBlock x:Name="OverlayScaleLabel" Grid.Column="2" Text="100%" Foreground="#E7B74E" FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="3" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP CROP" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="MapZoomSlider" Grid.Column="1" Minimum="100" Maximum="600" Value="225" SmallChange="10" LargeChange="35"
                            Margin="7,0" VerticalAlignment="Center" ValueChanged="MapZoomSlider_ValueChanged" />
                    <TextBlock x:Name="MapZoomLabel" Grid.Column="2" Text="225%" Foreground="#31A9D7" FontFamily="Bahnschrift" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP STYLE" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="CircleStyleButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="CIRCLE" Padding="8,4" Click="CircleStyleButton_Click" />
                    <Button x:Name="SquareStyleButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="SQUARE" Padding="8,4" Click="SquareStyleButton_Click" />
                </Grid>

                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="VISIBLE" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="MapVisibilityButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="MAP · ON" Padding="8,4" Click="MapVisibilityButton_Click" />
                    <Button x:Name="ActivityVisibilityButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="ACTIVITY · ON" Padding="8,4" Click="ActivityVisibilityButton_Click" />
                </Grid>

                <Grid Grid.Row="6" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP ROTATE" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="MapRotationButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="ROTATE · ON" Padding="8,4" Click="MapRotationButton_Click" />
                </Grid>

                <Grid Grid.Row="7" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="AUTO DETECT" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="AutoDetectLiveMapButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="LIVE MAP · ON" Padding="8,4" Click="AutoDetectLiveMapButton_Click" ToolTip="Nguồn dự phòng; Asset Location luôn được ưu tiên" />
                </Grid>

                <Grid Grid.Row="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="PRIME TASKS" Foreground="#D5DDD5" FontFamily="Bahnschrift SemiCondensed" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="PrimeTasksVisibilityButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="PRIME · OFF" Padding="8,4" Click="PrimeTasksVisibilityButton_Click" ToolTip="Tự động lấy tiến độ Prime từ telemetry của server" />
                </Grid>

                <Grid Grid.Row="9" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DragRegion" Background="#D5153732" BorderBrush="#64958B" BorderThickness="1" CornerRadius="2" Padding="9,5" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown" Cursor="SizeAll">
                        <TextBlock Text="✥  MOVE HUD" Foreground="#BBD1C9" FontFamily="Bahnschrift SemiCondensed" FontSize="9" />
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="HOME" Padding="7,3" Click="HomeButton_Click" ToolTip="Đổi nguồn telemetry" />
                    <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="RESET" Padding="7,3" Click="ResetSettingsButton_Click" />
                    <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Content="—" Width="25" Padding="0" Click="MinimizeButton_Click" />
                    <Button Grid.Column="7" Style="{StaticResource ChromeButton}" Content="×" Width="25" Padding="0" Click="CloseButton_Click" />

                    <primitives:Thumb x:Name="ResizeGrip" Grid.Column="9"
                                  Width="48" Height="29" Cursor="SizeNWSE"
                                  AutomationProperties.Name="Kéo để thay đổi kích thước toàn bộ overlay"
                                  ToolTip="Giữ và kéo để resize toàn bộ overlay"
                                  DragStarted="ResizeGrip_DragStarted"
                                  DragDelta="ResizeGrip_DragDelta"
                                  DragCompleted="ResizeGrip_DragCompleted">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border x:Name="GripChrome" CornerRadius="2"
                                    Background="#D5153732" BorderBrush="#64958B" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="SIZE" Foreground="#A8C8BF"
                                               FontFamily="Bahnschrift SemiCondensed" FontSize="7.5"
                                               Margin="6,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    <TextBlock Text="↘" Foreground="#37D4C6" FontSize="15"
                                               Margin="0,0,4,1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#E21B4942" />
                                    <Setter TargetName="GripChrome" Property="BorderBrush" Value="#79C5B8" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#F0275D54" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
            </Grid>
        </Border>

        </Grid>
    </Grid>
</Window>
