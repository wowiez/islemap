<Window x:Class="TheIsleOverlay.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Isle of Wie" SizeToContent="WidthAndHeight"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="True" ShowActivated="False"
        FontFamily="Segoe UI Variable Text" TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextHintingMode="Fixed" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closed="Window_Closed" DpiChanged="Window_DpiChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="HudPatternBrush" Color="#A8080D0C" />
    </Window.Resources>
    <Grid x:Name="OverlayScaleRoot" Width="318" UseLayoutRounding="True" SnapsToDevicePixels="True"
          RenderOptions.BitmapScalingMode="HighQuality">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="OverlayScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Grid Margin="7">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="MapPanel" Grid.Row="0" Height="304" Background="Transparent" ClipToBounds="False">
            <Grid>
                <Ellipse x:Name="CircularMapOuterFrame" Width="292" Height="292" Fill="Transparent" StrokeThickness="0" />
                <Ellipse x:Name="CircularMapInnerFrame" Width="286" Height="286" StrokeThickness="0" />
                <Border x:Name="SquareMapFrame" Width="296" Height="296" Visibility="Collapsed"
                        Background="Transparent" BorderThickness="0" CornerRadius="5" />

                <Canvas x:Name="MapViewport" Width="282" Height="282" Background="#102423"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        SizeChanged="MapViewport_SizeChanged" ClipToBounds="True">
                    <Canvas.Clip>
                        <EllipseGeometry Center="141,141" RadiusX="141" RadiusY="141" />
                    </Canvas.Clip>
                    <Image x:Name="MapImage" Panel.ZIndex="0" Stretch="Fill" Opacity="0.94" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="MapRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="MapImagePanTransform" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Rectangle x:Name="MapShade" Panel.ZIndex="1" Fill="#09000000" IsHitTestVisible="False" />
                    <Image x:Name="DrinkingWaterImage" Panel.ZIndex="1" Stretch="Fill" Opacity="0.65" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False">
                        <Image.Effect><BlurEffect Radius="0.45" RenderingBias="Quality" /></Image.Effect>
                        <Image.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="DrinkingWaterRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="DrinkingWaterPanTransform" />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                    <Canvas x:Name="SbtcZoneLayer" Panel.ZIndex="2" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcZoneRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcZonePanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcMapPoiLayer" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcMapPoiRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcMapPoiPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcZoneDecorationLayer" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcZoneDecorationRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcZoneDecorationPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcWildlifeLayer" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcWildlifeRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcWildlifePanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="PathTrailLayer" Panel.ZIndex="3" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="PathTrailRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="PathTrailPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="RouteLayer" Panel.ZIndex="4" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="RouteRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="RoutePanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Canvas x:Name="SbtcPlayerLayer" Panel.ZIndex="5" Visibility="Collapsed" IsHitTestVisible="False">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <RotateTransform x:Name="SbtcPlayerRotationTransform" Angle="0" CenterX="141" CenterY="141" />
                                <TranslateTransform x:Name="SbtcPlayerPanTransform" />
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>
                    <Grid x:Name="PlayerMarker" Panel.ZIndex="6" Width="34" Height="34" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="PlayerMarkerSizeTransform" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Ellipse Width="27" Height="27" Fill="#35FF2E88" />
                        <Ellipse Width="15" Height="15" Fill="#FF2E88" Stroke="#FFFFFF" StrokeThickness="2">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FF2E88" BlurRadius="8" ShadowDepth="0" Opacity="0.95" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <Grid x:Name="DirectionNeedle" Width="34" Height="34" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="DirectionNeedleRotationTransform" Angle="0" />
                            </Grid.RenderTransform>
                            <Path Data="F1 M 17,0 L 21,9 L 17,7 L 13,9 Z" Fill="#FFFFFF" Stroke="#FF2E88" StrokeThickness="1" />
                        </Grid>
                    </Grid>
                </Canvas>

                <Path x:Name="MapNorthIndicator" Visibility="Collapsed" Data="M 151,4 L 159,16 L 143,16 Z" Fill="#37D4C6" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Grid x:Name="CompassRing" Width="272" Height="272"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="CompassRingRotationTransform" Angle="0" />
                    </Grid.RenderTransform>
                    <TextBlock x:Name="CompassNorthLabel" Text="B" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="NorthLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassEastLabel" Text="Đ" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Right" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="EastLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassSouthLabel" Text="N" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="SouthLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock x:Name="CompassWestLabel" Text="T" Foreground="#F3F5ED" FontFamily="Segoe UI" FontStretch="Condensed" FontSize="11.5" FontWeight="Bold"
                               HorizontalAlignment="Left" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="0" Opacity="1" /></TextBlock.Effect>
                        <TextBlock.RenderTransform><RotateTransform x:Name="WestLabelCounterRotationTransform" Angle="0" /></TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>

                <TextBlock x:Name="CoordinateLabel" Visibility="Collapsed" Text="X —  Y —  Z —" />

                <Border x:Name="HeadingReadout" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#A8071110" CornerRadius="8" Padding="8,3">
                    <TextBlock x:Name="HeadingModeLabel" Text="CHƯA RÕ HƯỚNG" Foreground="#EEE9D9" FontFamily="{StaticResource WieFont}" FontSize="10.5" FontWeight="SemiBold" />
                </Border>

                <TextBlock x:Name="MapStateLabel" Text="ĐANG TẢI BẢN ĐỒ" Foreground="#A5BDB5" Background="#C0091718" Padding="10,6" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource WieFont}" FontSize="10" />
            </Grid>
        </Border>

        <Border x:Name="MapActivitySpacer" Grid.Row="1" Height="8" />

        <Border x:Name="ActivityPanel" Grid.Row="2" Width="248" HorizontalAlignment="Center"
                Background="{StaticResource HudPatternBrush}" BorderThickness="0"
                CornerRadius="10" Padding="8,6,8,6">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="ActivityReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="DinosaurHeaderRow" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="SpeciesLabel" Text="NO ACTIVE DINOSAUR" Foreground="#EEF3E8"
                               FontFamily="{StaticResource WieFont}" FontWeight="Bold" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="GROWTH" Foreground="#A9914A" FontFamily="{StaticResource WieFont}"
                                   FontSize="8.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBlock x:Name="GrowthLabel" Text="—" Foreground="#E6BD47" FontFamily="{StaticResource WieFont}"
                                   FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Ellipse x:Name="ConnectionDot" Visibility="Collapsed" Width="5" Height="5" />
                    <TextBlock x:Name="ConnectionLabel" Visibility="Collapsed" Text="ĐANG KHỞI TẠO" />
                    <TextBlock x:Name="PlayerNameLabel" Visibility="Collapsed" Text="Awaiting telemetry" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,5,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HealthValueColumn" Width="32" /></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Máu">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#33FF5A4F" Stroke="#FF5A4F" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="HealthBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,4,0" Foreground="#55D64E" VerticalAlignment="Center" />
                        <TextBlock x:Name="HealthValue" Grid.Column="2" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Text="- / -" Foreground="#E1E9E5" FontFamily="{StaticResource WieFont}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="StaminaValueColumn" Width="32" /></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Thể lực">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#33E6D24D" Stroke="#E6D24D" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="StaminaBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,4,0" Foreground="#E6D24D" VerticalAlignment="Center" />
                        <TextBlock x:Name="StaminaValue" Grid.Column="2" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Text="- / -" Foreground="#DDE6E1" FontFamily="{StaticResource WieFont}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="HungerValueColumn" Width="32" /></Grid.ColumnDefinitions>
                        <Viewbox x:Name="FoodSteakIcon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Thức ăn">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#33E49428" Stroke="#E49428" StrokeThickness="2" StrokeLineJoin="Round"
                                      Data="M15.4 15.63a7.875 6 135 1 1 6.23-6.23 4.5 3.43 135 0 0-6.23 6.23Z" />
                                <Path Stroke="#E49428" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M8.29 12.71 5.7 15.3a2.5 2.5 0 1 0-1.65 4.65A2.5 2.5 0 1 0 8.7 18.3l2.59-2.59" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="HungerBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,4,0" Foreground="#E49428" VerticalAlignment="Center" />
                        <TextBlock x:Name="HungerValue" Grid.Column="2" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Text="- / -" Foreground="#DDE6E1" FontFamily="{StaticResource WieFont}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="WaterValueColumn" Width="32" /></Grid.ColumnDefinitions>
                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Nước">
                            <Canvas Width="24" Height="24">
                                <Path Fill="#3331A9D7" Stroke="#31A9D7" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="WaterBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8" Margin="0,0,4,0" Foreground="#31A9D7" VerticalAlignment="Center" />
                        <TextBlock x:Name="WaterValue" Grid.Column="2" Typography.NumeralAlignment="Tabular" FontWeight="SemiBold" Text="- / -" Foreground="#DDE6E1" FontFamily="{StaticResource WieFont}" FontSize="10" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid x:Name="FractureRow" Margin="0,4,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="FractureValueColumn" Width="32" /></Grid.ColumnDefinitions>
                        <Viewbox x:Name="FractureIcon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Tình trạng xương">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="FractureBone" Fill="#33C9D4D0" Stroke="#C9D4D0" StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M17 10c.7-.7 1.69 0 2.5 0a2.5 2.5 0 1 0 0-5 .5.5 0 0 1-.5-.5 2.5 2.5 0 1 0-5 0c0 .81.7 1.8 0 2.5l-7 7c-.7.7-1.69 0-2.5 0a2.5 2.5 0 0 0 0 5c.28 0 .5.22.5.5a2.5 2.5 0 1 0 5 0c0-.81-.7-1.8 0-2.5Z" />
                            </Canvas>
                        </Viewbox>
                        <ProgressBar x:Name="FractureBar" Grid.Column="1" Style="{StaticResource TelemetryBar}" Height="8"
                                     Margin="0,0,4,0" Foreground="#C9D4D0" VerticalAlignment="Center" />
                        <TextBlock x:Name="FractureValue" Grid.Column="2" Text="—" Foreground="#D6DEDA"
                                   FontFamily="{StaticResource WieFont}" FontSize="9.5" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RequestStatusLabel" Text="" Foreground="#A9914A"
                               FontFamily="{StaticResource WieFont}" FontSize="8.5"
                               FontWeight="SemiBold" HorizontalAlignment="Left"
                               TextTrimming="CharacterEllipsis" Margin="2,0,8,0" />
                    <TextBlock x:Name="UpdatedLabel" Grid.Column="1" Text="—" Foreground="#788780"
                               FontFamily="{StaticResource WieFont}" FontSize="8.5" HorizontalAlignment="Right" />
                </Grid>
            </Grid>
        </Border>

        <Border x:Name="PrimeTasksPanel" Grid.Row="3" Width="248" HorizontalAlignment="Center" Visibility="Collapsed"
                Margin="0,8,0,0" Padding="10,8"
                Background="{StaticResource HudPatternBrush}" BorderBrush="#655A604D"
                BorderThickness="1" CornerRadius="4">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="PrimeTasksReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="6" Height="6" Fill="#E7B74E" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Grid.Column="1" Text="NHIỆM VỤ PRIME" Foreground="#EEF3E8"
                               FontFamily="{StaticResource WieFont}" FontSize="11.5" FontWeight="SemiBold" />
                    <TextBlock x:Name="PrimeTasksProgressLabel" Grid.Column="2" Text="0 / 0"
                               Foreground="#E7B74E" FontFamily="{StaticResource WieFont}" FontSize="10.5" FontWeight="Bold" />
                </Grid>
                <Rectangle Grid.Row="1" Fill="#405D56" Margin="0,7,0,0" />
                <ItemsControl x:Name="PrimeTasksList" Grid.Row="2" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1.5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="17" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Marker}" Foreground="{Binding MarkerBrush}"
                                           FontFamily="{StaticResource WieFont}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{Binding TextBrush}"
                                           FontFamily="{StaticResource WieFont}" FontSize="10.5"
                                           TextWrapping="Wrap" LineHeight="13" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <Border x:Name="MapKillFeedPanel" Grid.Row="4" Width="{Binding Width, ElementName=ActivityPanel}" HorizontalAlignment="Center"
                Visibility="Collapsed" Margin="0,8,0,0" Padding="9,7"
                Background="{StaticResource HudPatternBrush}" BorderThickness="0" CornerRadius="10">
            <Border.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ScaleX, ElementName=ActivityReadabilityScaleTransform}"
                                ScaleY="{Binding ScaleY, ElementName=ActivityReadabilityScaleTransform}" />
            </Border.LayoutTransform>
            <StackPanel>
                <Grid Margin="0,0,0,5">
                    <TextBlock x:Name="MapKillFeedTitle" Text="KILL FEED · SBTC" Foreground="#C9A95A" FontFamily="{StaticResource WieFont}" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock x:Name="MapKillFeedStatus" Text="Đang tải…" HorizontalAlignment="Right" Foreground="#98A18E" FontFamily="{StaticResource WieFont}" FontSize="8.5" />
                </Grid>
                <ItemsControl x:Name="MapKillFeedRows">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,3,0,3">
                                <TextBlock Text="{Binding Summary}" Foreground="{Binding Accent}" FontFamily="{StaticResource WieFont}" FontSize="10" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                <TextBlock Text="{Binding Detail}" Foreground="#98A18E" FontFamily="{StaticResource WieFont}" FontSize="8.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="MapKillFeedEmpty" Text="Đang tải Kill Feed…" Foreground="#98A18E" FontFamily="{StaticResource WieFont}" FontSize="9" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border x:Name="SettingsPanel" Grid.Row="5" Visibility="Collapsed"
                Margin="0,8,0,0" Padding="9,7"
                Background="{StaticResource HudPatternBrush}" BorderBrush="#654A6355" BorderThickness="1"
                CornerRadius="14">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="SettingsReadabilityScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OVERLAY SETTINGS" Foreground="#F8F3E3" FontFamily="{StaticResource WieFont}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="F8 · GUIDE  /  ALT + M · BIG MAP  /  ALT + = / - · ZOOM" Foreground="#9FA894" FontFamily="{StaticResource WieFont}" FontSize="8.5" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="DONE" Padding="10,4" Click="CloseSettingsButton_Click" />
                </Grid>

                <Rectangle Grid.Row="1" Fill="#405D56" Margin="0,7,0,0" />

                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBlock Text="HUD SIZE" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="OverlayScaleSlider" Grid.Column="1" Minimum="65" Maximum="175" Value="100" SmallChange="5" LargeChange="10"
                            TickFrequency="5" IsSnapToTickEnabled="True"
                            Margin="7,0" VerticalAlignment="Center" ValueChanged="OverlayScaleSlider_ValueChanged" />
                    <TextBlock x:Name="OverlayScaleLabel" Grid.Column="2" Text="100%" Foreground="#C9A95A" FontFamily="{StaticResource WieFont}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,7,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP CROP" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="MapZoomSlider" Grid.Column="1" Minimum="100" Maximum="1000" Value="225" SmallChange="10" LargeChange="50"
                            Margin="7,0" VerticalAlignment="Center" ValueChanged="MapZoomSlider_ValueChanged" />
                    <TextBlock x:Name="MapZoomLabel" Grid.Column="2" Text="225%" Foreground="#C9A95A" FontFamily="{StaticResource WieFont}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="46" /></Grid.ColumnDefinitions>
                    <TextBlock Text="ĐIỂM VỊ TRÍ" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Slider x:Name="PlayerMarkerScaleSlider" Grid.Column="1" Minimum="50" Maximum="200" Value="100"
                            TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" Margin="7,0"
                            VerticalAlignment="Center" ValueChanged="PlayerMarkerScaleSlider_ValueChanged" />
                    <TextBlock x:Name="PlayerMarkerScaleLabel" Grid.Column="2" Text="100%" Foreground="#C9A95A" FontFamily="{StaticResource WieFont}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <Grid Margin="0,7,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="LỚP AI" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="WildlifeBelowPlayerButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="DƯỚI ĐIỂM" Padding="6,4" Click="WildlifeBelowPlayerButton_Click" />
                    <Button x:Name="WildlifeAbovePlayerButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="TRÊN ĐIỂM" Padding="6,4" Click="WildlifeAbovePlayerButton_Click" />
                </Grid>
                </StackPanel>

                <Grid Grid.Row="4" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP STYLE" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="CircleStyleButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="CIRCLE" Padding="8,4" Click="CircleStyleButton_Click" />
                    <Button x:Name="SquareStyleButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="SQUARE" Padding="8,4" Click="SquareStyleButton_Click" />
                </Grid>

                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="VISIBLE" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="MapVisibilityButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="MAP · ON" Padding="8,4" Click="MapVisibilityButton_Click" />
                    <Button x:Name="ActivityVisibilityButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="ACTIVITY · ON" Padding="8,4" Click="ActivityVisibilityButton_Click" />
                </Grid>
                <Grid x:Name="MapKillFeedSettingRow" Margin="0,7,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="KILL FEED" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="MapKillFeedToggleButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="KILL FEED · OFF" Padding="8,4" Click="MapKillFeedToggleButton_Click" ToolTip="Hiện Kill Feed SBTC cạnh minimap · cập nhật mỗi 2 giây" />
                </Grid>
                </StackPanel>

                <Grid Grid.Row="6" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="MAP ROTATE" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="MapRotationButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="ROTATE · OFF" Padding="8,4" Click="MapRotationButton_Click" />
                </Grid>


                <Grid Grid.Row="8" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="PRIME TASKS" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="PrimeTasksVisibilityButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="PRIME · OFF" Padding="8,4" Click="PrimeTasksVisibilityButton_Click" ToolTip="Tự động lấy tiến độ Prime từ telemetry của server" />
                </Grid>

                <Grid Grid.Row="9" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="74" /><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="ĐƯỜNG ĐI" Foreground="#E9E1C9" FontFamily="{StaticResource WieFont}" FontSize="10" VerticalAlignment="Center" />
                    <Button x:Name="PathTrailToggleButton" Grid.Column="1" Style="{StaticResource ChromeButton}" Content="TRAIL · ON" Padding="8,4" Click="PathTrailToggleButton_Click" ToolTip="Bật/tắt hiển thị đường đi của bạn trên bản đồ" />
                    <Button x:Name="ClearPathTrailButton" Grid.Column="3" Style="{StaticResource ChromeButton}" Content="XÓA · Ctrl+R" Padding="8,4" Click="ClearPathTrailButton_Click" ToolTip="Xóa lịch sử đường đi hiện tại · Ctrl+R khi đang trong game hoặc overlay" />
                </Grid>

                <Grid Grid.Row="10" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DragRegion" Background="#D515241B" BorderBrush="#2E4637" BorderThickness="1" CornerRadius="9" Padding="7,5" MouseLeftButtonDown="DragRegion_MouseLeftButtonDown" Cursor="SizeAll" Margin="0,0,5,0" ToolTip="Giữ và kéo để di chuyển HUD" AutomationProperties.Name="Di chuyển HUD">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconMove}" Foreground="#C9A95A" Width="14" Height="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="HOME" Padding="6,3" Click="HomeButton_Click" ToolTip="Đổi nguồn telemetry" />
                    <Button Grid.Column="3" Style="{StaticResource ChromeButton}" Content="RESET" Padding="6,3" Click="ResetSettingsButton_Click" />
                    <Button Grid.Column="5" Style="{StaticResource ChromeButton}" Width="25" Padding="0" Click="MinimizeButton_Click" AutomationProperties.Name="Thu nhỏ">
                        <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconMinus}" Width="11" Height="11" />
                    </Button>
                    <Button Grid.Column="7" Style="{StaticResource ChromeButton}" Width="25" Padding="0" Click="CloseButton_Click" AutomationProperties.Name="Đóng">
                        <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconClose}" Width="11" Height="11" />
                    </Button>

                    <primitives:Thumb x:Name="ResizeGrip" Grid.Column="9"
                                  Width="60" Height="29" Cursor="SizeNWSE"
                                  AutomationProperties.Name="Kéo để thay đổi kích thước toàn bộ overlay"
                                  ToolTip="Giữ và kéo để resize toàn bộ overlay"
                                  DragStarted="ResizeGrip_DragStarted"
                                  DragDelta="ResizeGrip_DragDelta"
                                  DragCompleted="ResizeGrip_DragCompleted">
                    <primitives:Thumb.Template>
                        <ControlTemplate TargetType="{x:Type primitives:Thumb}">
                            <Border x:Name="GripChrome" CornerRadius="9"
                                    Background="#D515241B" BorderBrush="#2E4637" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="SIZE" Foreground="#E6E0CB" FontFamily="{StaticResource WieFont}" FontSize="10.5"
                                               Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconResize}" Foreground="#C9A95A"
                                                    Width="12" Height="12" Margin="0,0,7,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#E21B2E23" />
                                    <Setter TargetName="GripChrome" Property="BorderBrush" Value="#C9A95A" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="GripChrome" Property="Background" Value="#F022392B" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </primitives:Thumb.Template>
                </primitives:Thumb>
            </Grid>
            </Grid>
        </Border>

        </Grid>
    </Grid>
</Window>
