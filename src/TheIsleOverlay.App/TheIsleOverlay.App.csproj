<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TheIsleOverlay.Core\TheIsleOverlay.Core.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.EraGaming\TheIsleOverlay.EraGaming.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.IslePilot\TheIsleOverlay.IslePilot.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Pandora\TheIsleOverlay.Pandora.csproj" />
    <ProjectReference Include="..\TheIsleOverlay.Sbtc\TheIsleOverlay.Sbtc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GatewayMap.webp" />
    <Resource Include="Assets\GatewayDrinkingWater.webp" />
    <Resource Include="Assets\GatewayZones.json" />
    <Resource Include="Assets\IslePilotZones.json" />
    <Resource Include="Assets\DinoThumbnails\*.png" />
    <Resource Include="Assets\SbtcSanctuary.png" />
    <Resource Include="Assets\SbtcMigration.png" />
    <Resource Include="Assets\SbtcWildlifeIcons.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\GarageViewer\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>TheIsleOverlay.App.Program</StartupObject>
    <AssemblyName>IsleLiveMap</AssemblyName>
    <RootNamespace>TheIsleOverlay.App</RootNamespace>
    <Product>Isle Live Map</Product>
    <Description>Live map overlay for The Isle Evrima.</Description>
    <Authors>IsleLiveMap</Authors>
    <Version>1.9.7</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Assets\IsleLiveMap.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
