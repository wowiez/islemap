                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="RecommendationTitleLabel" Foreground="#EDF5F1"
                                       FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="Ưu tiên từ trái sang phải" HorizontalAlignment="Right"
                                       Foreground="#777A7F" VerticalAlignment="Center" />
                        </Grid>

                        <ItemsControl x:Name="MutationCards">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#C9161719" BorderBrush="#3B3D42" BorderThickness="1"
                                            CornerRadius="7" Padding="15" Margin="0,0,12,0" MinHeight="225">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Priority, StringFormat={}{0:00}}" Foreground="#D4D6D9"
                                                       FontFamily="Bahnschrift" FontWeight="Bold" />
                                            <TextBlock Grid.Row="1" Text="{Binding DisplayName}" Foreground="#F1F5F3"
                                                       FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="Bold"
                                                       TextWrapping="Wrap" Margin="0,9,0,1" />
                                            <Border Grid.Row="3" Background="#B8212225" CornerRadius="5" Padding="10" Margin="0,12,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Effect}" Foreground="#CACCCE" TextWrapping="Wrap" LineHeight="18" />
                                                    <TextBlock Text="{Binding Why}" Foreground="#92959A" TextWrapping="Wrap"
                                                               LineHeight="17" Margin="0,8,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Grid.Row="4" Text="{Binding Tag}" Foreground="#B8BBC0"
                                                       FontSize="9" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Background="#B816171A" BorderBrush="#3B3D42" BorderThickness="1" CornerRadius="6"
                                Padding="12" Margin="0,18,12,0">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Path Data="M8,1 A7,7 0 1 1 7.9,1 M8,7 L8,12 M8,4 L8,5" Stroke="#BFC1C5" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                                <TextBlock Grid.Column="1" Text="Đây là khuyến nghị cộng đồng theo vai trò của loài. Giá trị và pool có thể đổi theo patch hoặc cấu hình server; hãy kiểm tra trong TAB trước khi chọn."
                                           Foreground="#A5A8AD" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                        <TextBlock Text="Nguồn tham khảo: theisle.info · dữ liệu Mutation 28/05/2026"
                                   Foreground="#66696E" FontSize="10" Margin="0,10,0,0" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="CÀI ĐẶT" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Nguồn vị trí &amp; phím tắt" Foreground="#F1F2F3"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock Text="Nguồn nhanh được ưu tiên khi hoạt động; WS/REST vẫn tự động dự phòng khi dữ liệu chậm hoặc mất."
                                   Foreground="#95989D" FontSize="13" TextWrapping="Wrap" />

                        <TextBlock Text="VỊ TRÍ CỦA BẠN TRÊN BẢN ĐỒ" Foreground="#D5D7DA"
                                   FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="13" Margin="0,24,0,10" />
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#3E4045" BorderThickness="1"
                                CornerRadius="8" Padding="18">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Bắt gói tin từ game (Npcap)" Foreground="#F0F1F2"
                                                   FontFamily="Bahnschrift SemiCondensed" FontWeight="SemiBold" FontSize="16" />
                                        <TextBlock Text="Đọc luồng UDP của game để lấy vị trí nhanh; không đọc bộ nhớ và không can thiệp game."
                                                   Foreground="#8F9297" Margin="0,4,16,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="NpcapStatusLabel" Text="Đang kiểm tra Npcap…"
                                                   Foreground="#E7B74E" Margin="0,7,16,0" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button x:Name="NpcapToggleButton" Grid.Column="1" Content="BẬT"
                                            Style="{StaticResource SettingsActionButton}" Margin="0,0,8,0"
                                            Click="NpcapToggleButton_Click" />
                                    <Button x:Name="NpcapActionButton" Grid.Column="2" Content="MỞ LẠI"
                                            Style="{StaticResource SettingsActionButton}"
                                            Click="NpcapActionButton_Click" />
                                </Grid>
                                <Border BorderBrush="#303236" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="IslePilot Realtime + REST" Foreground="#E1E2E4" FontWeight="SemiBold" />
                                            <TextBlock Text="Luôn giữ làm nguồn dự phòng; tự nhận dữ liệu khi Npcap không có hoặc bị stale."
                                                       Foreground="#85888D" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="TỰ ĐỘNG" Foreground="#37D4C6" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#303236" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Copy Asset Location" Foreground="#E1E2E4" FontWeight="SemiBold" />
                                            <TextBlock Text="Luôn theo dõi clipboard và nhận tọa độ từ lệnh Copy Asset trong game."
                                                       Foreground="#85888D" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Text="TỰ ĐỘNG" Foreground="#37D4C6" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#303236" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Tự ẩn khi Alt+Tab" Foreground="#E1E2E4" FontWeight="SemiBold" />
                                            <TextBlock Text="Chỉ ẩn overlay khỏi màn hình khi ra ngoài game; app vẫn nằm trên taskbar."
                                                       Foreground="#85888D" Margin="0,3,16,0" />
                                        </StackPanel>
                                        <Button x:Name="AutoHideOutsideGameButton" Grid.Column="1" Content="BẬT"
                                                Style="{StaticResource SettingsActionButton}"
                                                Click="AutoHideOutsideGameButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PHÍM TẮT" Foreground="#D5D7DA" FontFamily="Bahnschrift SemiCondensed"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,24,0,10" />
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#3E4045" BorderThickness="1"
                                CornerRadius="8" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Mở / đóng cẩm nang" Foreground="#D9DBDE" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="GuideHotkeyButton" Grid.Column="1" Tag="guide" Content="F8" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="1" Text="Mở / đóng bản đồ lớn" Foreground="#D9DBDE" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="LargeMapHotkeyButton" Grid.Row="1" Grid.Column="1" Tag="large-map" Content="Alt + M" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="2" Text="Mở setting overlay" Foreground="#D9DBDE" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="SettingsHotkeyButton" Grid.Row="2" Grid.Column="1" Tag="settings" Content="Ctrl + Shift + O" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="3" Text="Phóng to / thu nhỏ minimap" Foreground="#D9DBDE" VerticalAlignment="Center" />
                                <Button x:Name="ZoomHotkeyButton" Grid.Row="3" Grid.Column="1" Tag="zoom" Content="Alt +  /  Alt −" Style="{StaticResource ShortcutBoxButton}" Click="HotkeyButton_Click" />
                                <Button Grid.Row="4" Grid.ColumnSpan="2" Content="RESET PHÍM TẮT" Style="{StaticResource NavButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ResetHotkeysButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
