                            <TextBlock Text="SBTC ISLAND · KILL FEED" Foreground="{StaticResource AccentBrush}"
                                       FontFamily="{StaticResource WieFont}" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock Text="Nhật ký giao tranh" Foreground="#FAF6EA" FontFamily="{StaticResource WieFont}" FontSize="30" FontWeight="Bold" Margin="0,4,0,6" />
                            <TextBlock Text="Các trận gần nhất trên server · lọc theo loài của người hạ hoặc nạn nhân." Foreground="#99A28E" TextWrapping="Wrap" />
                        </StackPanel>
