                                            <StackPanel Grid.Row="1" Margin="18,16,18,17">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#FAF6E8"
                                                                   FontFamily="{StaticResource WieFont}" FontSize="19"
                                                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
