                                        <StackPanel>
                                            <TextBlock Text="Tự ẩn khi Alt+Tab" Foreground="#F1EAD4" FontWeight="SemiBold" />
                                            <TextBlock Text="Chỉ ẩn overlay khỏi màn hình khi ra ngoài game; app vẫn nằm trên taskbar."
                                                       Foreground="#8A957D" Margin="0,3,16,0" />
                                        </StackPanel>
                                        <Button x:Name="AutoHideOutsideGameButton" Grid.Column="1" Content="BẬT"
                                                Style="{StaticResource SettingsActionButton}"
                                                Click="AutoHideOutsideGameButton_Click" />
                                    </Grid>
                                </Border>
                                <Border BorderBrush="#283E32" BorderThickness="0,1,0,0" Margin="0,14,0,0" Padding="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Đường đi người chơi (Path Trail)" Foreground="#F1EAD4" FontWeight="SemiBold" />
                                            <TextBlock Text="Hiển thị vệt đường đi mỏng của bạn trên bản đồ; lưu vết tối đa 3 tiếng."
                                                       Foreground="#8A957D" Margin="0,3,16,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button x:Name="GuidePathTrailToggleButton" Grid.Column="1" Content="BẬT"
                                                Style="{StaticResource SettingsActionButton}"
                                                Click="GuidePathTrailToggleButton_Click" />
                                        <Button x:Name="GuideClearPathTrailButton" Grid.Column="3" Content="XÓA VỆT · Ctrl+R"
                                                Style="{StaticResource SettingsActionButton}"
                                                Click="GuideClearPathTrailButton_Click" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PHÍM TẮT" Foreground="#E7E0C8" FontFamily="{StaticResource WieFont}"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,24,0,10" />
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#364D40" BorderThickness="1"
                                CornerRadius="18" Padding="18">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Mở / đóng cẩm nang" Foreground="#EBE4CC" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="GuideHotkeyButton" Grid.Column="1" Tag="guide" Content="F8" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="1" Text="Mở / đóng bản đồ lớn" Foreground="#EBE4CC" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="LargeMapHotkeyButton" Grid.Row="1" Grid.Column="1" Tag="large-map" Content="Alt + M" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="2" Text="Mở setting overlay" Foreground="#EBE4CC" VerticalAlignment="Center" Margin="0,0,0,9" />
                                <Button x:Name="SettingsHotkeyButton" Grid.Row="2" Grid.Column="1" Tag="settings" Content="Ctrl + Shift + O" Style="{StaticResource ShortcutBoxButton}" Margin="0,0,0,9" Click="HotkeyButton_Click" />
                                <TextBlock Grid.Row="3" Text="Phóng to / thu nhỏ minimap" Foreground="#EBE4CC" VerticalAlignment="Center" />
                                <Button x:Name="ZoomHotkeyButton" Grid.Row="3" Grid.Column="1" Tag="zoom" Content="Alt +  /  Alt −" Style="{StaticResource ShortcutBoxButton}" Click="HotkeyButton_Click" />
                                <Button Grid.Row="4" Grid.ColumnSpan="2" Content="RESET PHÍM TẮT" Style="{StaticResource NavButton}" Margin="0,12,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="ResetHotkeysButton_Click" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</Window>
