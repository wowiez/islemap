<Window x:Class="TheIsleOverlay.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheIsleOverlay.App"
        Title="Isle Live Map · Cẩm nang" Width="1080" Height="760"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False" KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#C9161719" />
        <SolidColorBrush x:Key="BorderBrush" Color="#3B3D41" />
        <SolidColorBrush x:Key="AccentBrush" Color="#E2E4E7" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9A9DA2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3B3D41" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#292B2F" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#66696E" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#34363A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="#0D1713" />
            <Setter Property="Background" Value="#9FD8B5" />
            <Setter Property="BorderBrush" Value="#BCE8CB" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#B9E8C9" />
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#D7F4DF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Background" Value="#8FC7A5" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryBorder" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HexInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#F0F1F2" />
            <Setter Property="Background" Value="#17191B" />
            <Setter Property="BorderBrush" Value="#45484C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#546B62" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="HexBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HexBorder" Property="BorderBrush" Value="#8FA99E" />
                                <Setter TargetName="HexBorder" Property="Background" Value="#202326" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#606761" />
            <Setter Property="Background" Value="#17191B" />
            <Setter Property="ToolTip" Value="Chọn màu" />
        </Style>
        <Style x:Key="TrackButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutBox" TargetType="Border">
            <Setter Property="Background" Value="#17181A" />
            <Setter Property="BorderBrush" Value="#45474C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style x:Key="ShortcutBoxButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#17181A" />
            <Setter Property="BorderBrush" Value="#45474C" />
            <Setter Property="Foreground" Value="#F2F3F4" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style x:Key="GuideProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="7" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="#C8CACD" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#ECEDEF" />
            <Setter Property="Background" Value="#17181A" />
            <Setter Property="BorderBrush" Value="#55585D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="#17181A" BorderBrush="#55585D"
                                                BorderThickness="1" CornerRadius="5" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding SelectedItem.Name, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                           Foreground="#FFFFFF" FontFamily="Bahnschrift SemiCondensed"
                                                           FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Path Grid.Column="1" Data="M 2 3 L 7 8 L 12 3" Stroke="#D9DBDE"
                                                      StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#9B9EA3" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#222326" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#B8BBC0" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="390" Margin="0,4,0,0" Padding="4"
                                        Background="#FA111214" BorderBrush="#55585D" BorderThickness="1"
                                        CornerRadius="6">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E4E5E7" />
            <Setter Property="Background" Value="#151618" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2B2F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#3A3C41" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="0" Background="#E80B0C0E" CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#323438" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M8,0 L10,6 L16,8 L10,10 L8,16 L6,10 L0,8 L6,6 Z"
                              Fill="#D7D9DC" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="ISLE LIVE MAP · CẨM NANG" Foreground="#EAF4F0"
                                       FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="F8 · MỞ / ĐÓNG" Foreground="#617D76" FontSize="9" />
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="30"
                            Content="×" Foreground="#C5C7CA" Background="#1C1D20"
                            BorderBrush="#404247" FontSize="17" Cursor="Hand" Click="CloseButton_Click" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#B8111214" BorderBrush="#303236" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="16,7">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Click="OverviewNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M8,1 A3,3 0 1 1 7.9,1 M2,15 C2,10 14,10 14,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="TỔNG QUAN" /></StackPanel>
                    </Button>
                    <Button x:Name="MapNavButton" Style="{StaticResource NavButton}" Click="MapNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M1,3 L5,1 L11,3 L15,1 L15,13 L11,15 L5,13 L1,15 Z M5,1 L5,13 M11,3 L11,15" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="BẢN ĐỒ ĐẢO" /></StackPanel>
                    </Button>
                    <Button x:Name="GarageNavButton" Style="{StaticResource NavButton}" Click="GarageNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M1,6 L8,1 L15,6 L15,15 L1,15 Z M4,15 L4,8 L12,8 L12,15 M6,11 L10,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="GARAGE" /></StackPanel>
                    </Button>
                    <Button x:Name="SkinEditorNavButton" Style="{StaticResource NavButton}" Click="SkinEditorNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M2,13 C4,7 5,3 8,2 C11,3 12,7 14,13 M5,9 L11,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="SKIN 3D" /></StackPanel>
                    </Button>
                    <Button x:Name="VoiceNavButton" Style="{StaticResource NavButton}" Click="VoiceNavButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><Path Data="M3,7 L3,10 C3,13 5,15 8,15 C11,15 13,13 13,10 L13,7 M8,15 L8,18 M5,18 L11,18 M5,2 C5,0 11,0 11,2 L11,9 C11,13 5,13 5,9 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="VOICE" /></StackPanel>
                    </Button>
                    <Button x:Name="MutationNavButton" Style="{StaticResource NavButton}" Click="MutationNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M8,1 C3,3 3,7 8,8 C13,9 13,13 8,15 M8,1 C13,3 13,7 8,8 C3,9 3,13 8,15 M4,4 L12,4 M4,12 L12,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="TIẾN HÓA MUTATION" /></StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal"><Path Data="M8,1 A7,7 0 1 1 7.9,1 M8,5 A3,3 0 1 1 7.9,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.35" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="CÀI ĐẶT" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="TỔNG QUAN" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Dino hiện tại" Foreground="#F1F2F3"
                                   FontFamily="Bahnschrift SemiCondensed" FontSize="30" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock x:Name="OverviewStateLabel" Text="Đang chờ dữ liệu từ server"
                                   Foreground="#95989D" FontSize="13" TextWrapping="Wrap" />

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#3E4045" BorderThickness="1"
                                CornerRadius="8" Padding="20" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="ĐANG CHƠI" Foreground="#85888D" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OverviewSpeciesLabel" Text="NO ACTIVE DINOSAUR" Foreground="#F0F1F2"
                                               FontFamily="Bahnschrift SemiCondensed" FontWeight="Bold" FontSize="25" Margin="0,6,0,0" />
                                    <TextBlock x:Name="OverviewPlayerLabel" Text="—" Foreground="#A1A4A8" Margin="0,3,0,0" />
                                    <Grid Margin="0,18,0,0">
                                        <TextBlock Text="GROWTH" Foreground="#777A7F" FontSize="10" />
                                        <TextBlock x:Name="OverviewGrowthLabel" Text="—" Foreground="#E1E2E4"
                                                   HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                    <ProgressBar x:Name="OverviewGrowthBar" Style="{StaticResource GuideProgress}" Margin="0,6,0,0" />
                                    <TextBlock x:Name="OverviewServerLabel" Text="Chưa kết nối server" Foreground="#717479"
                                               FontSize="10" Margin="0,13,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" /><RowDefinition Height="*" />
                                        <RowDefinition Height="*" /><RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions><TextBlock Text="HP" Foreground="#AEB0B4" /><ProgressBar x:Name="OverviewHealthBar" Grid.Column="1" Style="{StaticResource GuideProgress}" VerticalAlignment="Center" Foreground="#D7D9DC" /><TextBlock x:Name="OverviewHealthLabel" Grid.Column="2" Text="—" Foreground="#C7C9CC" HorizontalAlignment="Right" /></Grid>
                                    <Grid Grid.Row="1" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions><TextBlock Text="STAMINA" Foreground="#AEB0B4" /><ProgressBar x:Name="OverviewStaminaBar" Grid.Column="1" Style="{StaticResource GuideProgress}" VerticalAlignment="Center" Foreground="#BFC1C5" /><TextBlock x:Name="OverviewStaminaLabel" Grid.Column="2" Text="—" Foreground="#C7C9CC" HorizontalAlignment="Right" /></Grid>
                                    <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions><TextBlock Text="FOOD" Foreground="#AEB0B4" /><ProgressBar x:Name="OverviewFoodBar" Grid.Column="1" Style="{StaticResource GuideProgress}" VerticalAlignment="Center" Foreground="#A8AAAE" /><TextBlock x:Name="OverviewFoodLabel" Grid.Column="2" Text="—" Foreground="#C7C9CC" HorizontalAlignment="Right" /></Grid>
                                    <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /><ColumnDefinition Width="50" /></Grid.ColumnDefinitions><TextBlock Text="WATER" Foreground="#AEB0B4" /><ProgressBar x:Name="OverviewWaterBar" Grid.Column="1" Style="{StaticResource GuideProgress}" VerticalAlignment="Center" Foreground="#92959A" /><TextBlock x:Name="OverviewWaterLabel" Grid.Column="2" Text="—" Foreground="#C7C9CC" HorizontalAlignment="Right" /></Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <TextBlock Text="HELP · PHÍM TẮT" Foreground="#D5D7DA" FontFamily="Bahnschrift SemiCondensed"
                                   FontWeight="SemiBold" FontSize="13" Margin="0,24,0,10" />
                        <UniformGrid Columns="2">
                            <Border Background="#B8131416" BorderBrush="#35373B" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,10,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="F8" Foreground="#F1F2F3" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Mở / đóng cẩm nang" Foreground="#96999E" /></Grid></Border>
                            <Border Background="#B8131416" BorderBrush="#35373B" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,0,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="ALT + M" Foreground="#F1F2F3" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Mở / đóng bản đồ tương tác" Foreground="#96999E" /></Grid></Border>
                            <Border Background="#B8131416" BorderBrush="#35373B" BorderThickness="1" CornerRadius="6" Padding="13" Margin="0,0,10,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="ALT + / −" Foreground="#F1F2F3" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Zoom minimap" Foreground="#96999E" /></Grid></Border>
                            <Border Background="#B8131416" BorderBrush="#35373B" BorderThickness="1" CornerRadius="6" Padding="13"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="CTRL + SHIFT + O" Foreground="#F1F2F3" FontFamily="Bahnschrift" FontWeight="Bold" /><TextBlock Grid.Column="1" Text="Mở setting overlay" Foreground="#96999E" /></Grid></Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="MapPage" Visibility="Collapsed" Margin="20">
                    <ContentControl x:Name="GuideMapHost" HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </Grid>

                <ScrollViewer x:Name="GaragePage" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="24,20,20,24">
                        <Grid Margin="0,0,4,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M1,6 L8,1 L15,6 L15,15 L1,15 Z M4,15 L4,8 L12,8 L12,15"
                                          Stroke="#D7D9DC" StrokeThickness="1.4" Width="13" Height="13"
                                          Stretch="Uniform" Margin="0,0,8,0" />
                                    <TextBlock Text="DINO GARAGE" Foreground="{StaticResource AccentBrush}"
                                               FontWeight="SemiBold" FontSize="12" />
                                </StackPanel>
                                <TextBlock Text="Dinosaur đã lưu" Foreground="#F2F3F4"
                                           FontFamily="Bahnschrift SemiCondensed" FontSize="30"
                                           FontWeight="Bold" Margin="0,3,0,2" />
                                <TextBlock Text="Đồng bộ trực tiếp với IslePilot · có xác nhận trước khi cất hoặc lấy Dino"
                                           Foreground="#898C91" FontSize="12" />
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
