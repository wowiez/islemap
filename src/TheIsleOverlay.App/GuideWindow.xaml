                                            <TextBlock Text="{Binding Time}" Foreground="#AAB2A1" FontSize="12" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Killer}" Foreground="{Binding Accent}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
