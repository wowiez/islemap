                                                        <TextBlock Text="{Binding MutationLabel}" Foreground="#B2B9AA" FontSize="9"
                                                                   FontWeight="SemiBold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
