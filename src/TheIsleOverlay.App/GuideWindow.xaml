                                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="FOOD" Foreground="#7C876F" FontSize="9" /><ProgressBar Grid.Column="1" Value="{Binding Hunger}" Style="{StaticResource GuideProgress}" Height="5" VerticalAlignment="Center" Foreground="#E49428" /><TextBlock Grid.Column="2" Text="{Binding HungerLabel}" Foreground="#B2B9AA" FontSize="9" HorizontalAlignment="Right" /></Grid>
                                                <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="WATER" Foreground="#7C876F" FontSize="9" /><ProgressBar Grid.Column="1" Value="{Binding Thirst}" Style="{StaticResource GuideProgress}" Height="5" VerticalAlignment="Center" Foreground="#31A9D7" /><TextBlock Grid.Column="2" Text="{Binding ThirstLabel}" Foreground="#B2B9AA" FontSize="9" HorizontalAlignment="Right" /></Grid>
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="65" /><ColumnDefinition Width="*" /><ColumnDefinition Width="42" /></Grid.ColumnDefinitions><TextBlock Text="STAMINA" Foreground="#7C876F" FontSize="9" /><ProgressBar Grid.Column="1" Value="{Binding Stamina}" Style="{StaticResource GuideProgress}" Height="5" VerticalAlignment="Center" Foreground="#E6D24D" /><TextBlock Grid.Column="2" Text="{Binding StaminaLabel}" Foreground="#B2B9AA" FontSize="9" HorizontalAlignment="Right" /></Grid>

