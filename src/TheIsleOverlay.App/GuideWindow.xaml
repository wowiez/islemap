<Window x:Class="TheIsleOverlay.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheIsleOverlay.App"
        Title="Isle of Wie · Cẩm nang" Width="1080" Height="760"
        MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" AllowsTransparency="True"
        Topmost="True" ShowInTaskbar="False" KeyDown="Window_KeyDown"
        FontFamily="{StaticResource WieFont}" TextOptions.TextFormattingMode="Ideal"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#C9111E17" />
        <SolidColorBrush x:Key="BorderBrush" Color="#324A3C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#F2ECD7" />
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#9FA894" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#324A3C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontFamily" Value="{StaticResource WieFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#22362B" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5E7668" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2C4236" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Foreground" Value="#14211A" />
            <Setter Property="Background" Value="#ECDFB3" />
            <Setter Property="BorderBrush" Value="#D9C58C" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimaryBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Background" Value="#F7EFD0" />
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#ECDFB3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="PrimaryBorder" Property="Background" Value="#D9C58C" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryBorder" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave"><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="PrimaryBorder" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HexInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FAF6E8" />
            <Setter Property="Background" Value="#131F18" />
            <Setter Property="BorderBrush" Value="#3C5547" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#536C5E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="HexBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="HexBorder" Property="BorderBrush" Value="#9DA692" />
                                <Setter TargetName="HexBorder" Property="Background" Value="#1B2B22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorPickerButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="#577062" />
            <Setter Property="Background" Value="#131F18" />
            <Setter Property="ToolTip" Value="Chọn màu" />
        </Style>
        <Style x:Key="TrackButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Height" Value="66" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="SettingsActionButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ShortcutBox" TargetType="Border">
            <Setter Property="Background" Value="#121F18" />
            <Setter Property="BorderBrush" Value="#3C5547" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style x:Key="ShortcutBoxButton" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="#121F18" />
            <Setter Property="BorderBrush" Value="#3C5547" />
            <Setter Property="Foreground" Value="#FAF7EC" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource WieScrollBar}" />
        <Style x:Key="GuideProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="8" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Background" Value="#1F3127" />
            <Setter Property="Foreground" Value="#D9D2BC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="True">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Track" />
                            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8F3E3" />
            <Setter Property="Background" Value="#121F18" />
            <Setter Property="BorderBrush" Value="#4D6557" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontFamily" Value="{StaticResource WieFont}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="#121F18" BorderBrush="#4D6557"
                                                BorderThickness="1" CornerRadius="12" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="22" /></Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="#FFFFFF" TextElement.FontFamily="{StaticResource WieFont}"
                                                                  TextElement.FontWeight="SemiBold" TextElement.FontSize="14"
                                                                  VerticalAlignment="Center" />
                                                <Path Grid.Column="1" Data="M 2 3 L 7 8 L 12 3" Stroke="#EBE4CC"
                                                      StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#A0A995" />
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#1C2C23" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#C5C1B3" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=DropDownToggle}"
                                        MaxHeight="390" Margin="0,4,0,0" Padding="4"
                                        Background="#FA0E1712" BorderBrush="#4D6557" BorderThickness="1"
                                        CornerRadius="12">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled"
                                                  PanningMode="VerticalOnly">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F3EDD8" />
            <Setter Property="Background" Value="#111C16" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="{StaticResource WieFont}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#23362B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#32493C" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="0" Background="#E809100C" CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="54" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#2A4034" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="16,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/IsleOfWieIcon.png" Width="30" Height="30" Margin="0,0,11,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource WieFont}" FontSize="16" FontWeight="Bold">
                                <Run Text="ISLE OF " Foreground="{StaticResource WieCream}" /><Run Text="WIE" Foreground="{StaticResource WieGold}" /><Run Text="  ·  Cẩm nang" Foreground="{StaticResource WieMuted}" FontWeight="Medium" FontSize="14" />
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Margin="1,1,0,0">
                                <Ellipse Width="6" Height="6" Fill="{StaticResource WieLive}" VerticalAlignment="Center" />
                                <TextBlock Text="F8 · mở / đóng" Foreground="{StaticResource WieFaint}" FontSize="10.5" Margin="6,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="34" Height="30"
                            Style="{StaticResource WieGhostButton}"
                            AutomationProperties.Name="Đóng cẩm nang" Click="CloseButton_Click">
                        <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconClose}" Width="15" Height="15" />
                    </Button>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#B80E1712" BorderBrush="#283E32" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="16,7">
                    <Button x:Name="OverviewNavButton" Style="{StaticResource NavButton}" Click="OverviewNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconUser}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="TỔNG QUAN" /></StackPanel>
                    </Button>
                    <Button x:Name="MapNavButton" Style="{StaticResource NavButton}" Click="MapNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconMap}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="BẢN ĐỒ ĐẢO" /></StackPanel>
                    </Button>
                    <Button x:Name="GarageNavButton" Visibility="Collapsed" Style="{StaticResource NavButton}" Click="GarageNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconGarage}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="GARAGE" /></StackPanel>
                    </Button>
                    <Button x:Name="SkinEditorNavButton" Style="{StaticResource NavButton}" Click="SkinEditorNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconPalette}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="SKIN 3D" /></StackPanel>
                    </Button>
                    <Button x:Name="VoiceNavButton" Style="{StaticResource NavButton}" Click="VoiceNavButton_Click" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconMic}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="VOICE" /></StackPanel>
                    </Button>
                    <Button x:Name="MutationNavButton" Style="{StaticResource NavButton}" Click="MutationNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconDna}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="TIẾN HÓA MUTATION" /></StackPanel>
                    </Button>
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="SettingsNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconSliders}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="CÀI ĐẶT" /></StackPanel>
                    </Button>
                    <Button x:Name="KillFeedNavButton" Style="{StaticResource NavButton}" Click="KillFeedNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconSwords}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="KILL FEED" /></StackPanel>
                    </Button>
                    <Button x:Name="FriendsNavButton" Style="{StaticResource NavButton}" Click="FriendsNavButton_Click">
                        <StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconUsers}" Width="15" Height="15" Margin="0,0,8,0" /><TextBlock Text="BẠN BÈ" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="FriendsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar">
                            <Setter Property="Width" Value="8" />
                            <Setter Property="Background" Value="#15221B" />
                            <Setter Property="Template"><Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" /></Track.DecreaseRepeatButton>
                                            <Track.Thumb><Thumb Background="#4F6759"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" /></Track.IncreaseRepeatButton>
                                        </Track>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                    </ScrollViewer.Resources>
                    <StackPanel Margin="24">
                        <TextBlock Text="BẠN BÈ" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="{StaticResource WieFont}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Bạn bè overlay" Foreground="#FAF6EA"
                                   FontFamily="{StaticResource WieFont}" FontSize="30" FontWeight="Bold" Margin="0,4,0,0" />
                        <TextBlock Text="Kết bạn cần chấp thuận · chỉ hiện vị trí khi cùng server · vị trí tự ẩn sau 10 giây mất cập nhật" Foreground="#9FA894" Margin="0,8,0,18" TextWrapping="Wrap" />
                        <StackPanel x:Name="FriendsActions">
                            <StackPanel x:Name="FriendSetupPanel">
                                <TextBlock Text="Tên duy nhất (2–32 ký tự, hỗ trợ tiếng Việt có dấu, không phân biệt hoa/thường)" Foreground="{StaticResource WieText}" TextWrapping="Wrap" />
                                <TextBox x:Name="FriendNewName" Style="{StaticResource HexInput}" MaxLength="32" Margin="0,6,0,8" />
                                <Button Content="TẠO TÀI KHOẢN OVERLAY" Style="{StaticResource NavButton}" Click="FriendCreate_Click" HorizontalAlignment="Left" />
                                <TextBlock Text="Đã có tài khoản? Nhập mã khôi phục từ máy cũ. Khôi phục sẽ đăng xuất máy cũ và cấp mã dự phòng mới." Foreground="#9FA894" Margin="0,20,0,8" TextWrapping="Wrap" />
                                <Border Background="#131F18" BorderBrush="#3C5547" BorderThickness="1" CornerRadius="12" Padding="9,6">
                                    <PasswordBox x:Name="FriendRecoveryInput" Background="Transparent" BorderThickness="0"
                                                 Foreground="#FAF6E8" CaretBrush="#FFFFFF" FontSize="12" />
                                </Border>
                                <Button Content="KHÔI PHỤC TÀI KHOẢN" Style="{StaticResource NavButton}" Click="FriendRecover_Click" HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="FriendAccountPanel" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="FriendNameInput" Style="{StaticResource HexInput}" FontFamily="{StaticResource WieFont}" Width="240" MaxLength="32" ToolTip="Tên có dấu được hỗ trợ. Đổi tên vẫn giữ bạn bè và mã kết bạn." />
                                    <Button Content="ĐỔI TÊN" Style="{StaticResource NavButton}" Click="FriendRename_Click" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="FriendCodeLabel" Foreground="{StaticResource WieSand}" FontSize="17" Margin="0,12,0,10" />
                                <WrapPanel>
                                    <Button Content="COPY MÃ KẾT BẠN" Style="{StaticResource NavButton}" Click="FriendCopyCode_Click" />
                                    <Button Content="LƯU MÃ KHÔI PHỤC" Style="{StaticResource NavButton}" Click="FriendBackup_Click" />
                                    <Button x:Name="FriendShareButton" Content="CHIA SẺ VỊ TRÍ: BẬT" Style="{StaticResource NavButton}" Click="FriendShare_Click" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,12">
                                    <ComboBox x:Name="FriendInviteLookup" SelectedIndex="0" Width="85" Margin="0,0,8,0" VerticalContentAlignment="Center">
                                        <ComboBoxItem Content="Tên" /><ComboBoxItem Content="Mã" />
                                    </ComboBox>
                                    <TextBox x:Name="FriendInviteCode" Style="{StaticResource HexInput}" Width="240" MaxLength="32" ToolTip="Nhập tên tài khoản hoặc mã kết bạn theo lựa chọn bên trái" />
                                    <Button Content="GỬI LỜI MỜI" Style="{StaticResource NavButton}" Click="FriendInvite_Click" Margin="8,0,8,0" />
                                    <Button Content="TẢI LẠI" Style="{StaticResource NavButton}" Click="FriendRefresh_Click" />
                                </StackPanel>
                                <TextBlock x:Name="FriendsStatus" Foreground="{StaticResource WieSand}" Margin="0,0,0,12" TextWrapping="Wrap" />
                                <TextBlock x:Name="FriendCountLabel" Foreground="#99A38E" FontSize="11" Margin="0,10,0,12" />
                                <ListBox x:Name="FriendRows" MaxHeight="420" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="OverviewPage" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="24">
                        <TextBlock Text="TỔNG QUAN" Foreground="{StaticResource AccentBrush}"
                                   FontFamily="{StaticResource WieFont}" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock Text="Dino hiện tại" Foreground="#FAF6EA"
                                   FontFamily="{StaticResource WieFont}" FontSize="30" FontWeight="Bold" Margin="0,4,0,4" />
                        <TextBlock x:Name="OverviewStateLabel" Text="Đang chờ dữ liệu từ server"
                                   Foreground="#9AA38F" FontSize="13" TextWrapping="Wrap" />

                        <Border Background="{StaticResource PanelBrush}" BorderBrush="#364D40" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,20,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,24,0">
                                    <TextBlock Text="ĐANG CHƠI" Foreground="#8A957D" FontSize="10" FontWeight="SemiBold" />
                                    <TextBlock x:Name="OverviewSpeciesLabel" TextTrimming="CharacterEllipsis" Text="NO ACTIVE DINOSAUR" Foreground="#FAF6E8"
                                               FontFamily="{StaticResource WieFont}" FontWeight="Bold" FontSize="25" Margin="0,6,0,0" />
                                    <TextBlock x:Name="OverviewPlayerLabel" Text="—" Foreground="#A5AE9B" Margin="0,3,0,0" />
                                    <Grid Margin="0,18,0,0">
