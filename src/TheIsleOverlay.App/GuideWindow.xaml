                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <ContentControl Style="{StaticResource WieIcon}" Tag="{StaticResource IconArrowRight}" Foreground="{Binding Accent}" Width="22" Height="22" HorizontalAlignment="Center" />
